<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>spring-ai-ragr</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>ragr-service-parent</artifactId>
    <packaging>pom</packaging>
    <name>ragr-service-parent</name>
    <description>What the three applications have in common: web, observability, the model client, and how their JVMs run</description>

    <!-- The parent of ragr-app, ragr-ingest and ragr-eval, and not of ragr-shared, which must stay a plain
         library. Only what all three need is here; a dependency two of them share stays in their own
         poms, since it says what each application is. -->

    <properties>
        <spring-boot.run.skip>false</spring-boot.run.skip>
        <!-- Each application sets its heap cap, ragr.heap. Every JVM is capped and runs SerialGC, to fit
             beside the two models. The same options must reach the IntelliJ run configurations and
             JDK_JAVA_OPTIONS in compose.yaml. -->
        <ragr.jvm.options>-Xmx${ragr.heap} -XX:+UseSerialGC</ragr.jvm.options>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>ragr-shared</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Ollama: chat in ragr-app, embedding in ragr-ingest, the judges in ragr-eval. Each switches off
             in configuration the half it does not use. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>

        <!-- Observability: metrics scraped by Prometheus, traces to the collector, logs to Loki. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- The OpenTelemetry SDK, Micrometer's bridge to it, and the OTLP exporter. It also brings an
             OTLP metrics registry, switched off in each application's configuration, since Prometheus
             scrapes the metrics. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.loki4j</groupId>
            <artifactId>loki-logback-appender</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <jvmArguments>${ragr.jvm.options}</jvmArguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The test JVM loads the full context beside the running applications, so it gets
                         the same cap. Merged with the root's surefire configuration. -->
                    <argLine>${ragr.jvm.options}</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

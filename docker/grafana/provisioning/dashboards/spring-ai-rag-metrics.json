    {
      "id": 3,
      "title": "Token usage rate",
      "description": "gen_ai_client_token_usage_total — input/output/total tokens per second, by operation",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },

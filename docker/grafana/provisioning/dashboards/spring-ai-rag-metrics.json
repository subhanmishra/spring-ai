    {
      "id": 6,
      "title": "RAG advisor chain — avg and p95 by advisor",
      "description": "Time spent inside each ChatClient advisor, as both the mean and the p95. QuestionAnswerAdvisor is the pgvector similarity search that grounds a chat answer, so this separates retrieval cost from generation cost. The two series answer different questions and were previously on two different dashboards: the mean tracks steady-state cost, while the gap between mean and p95 is what exposes an occasional slow retrieval that an average hides. Quantiles and averages use a 1h window: with a handful of requests an hour, a 5m window is NaN (drawn as nothing, not as zero) except in the five minutes after a request. A value here therefore describes the last hour of requests, and a line holding flat means no new ones.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(spring_ai_advisor_seconds_sum{application=\"spring-ai-ragr\"}[1h])) by (spring_ai_advisor_name) / sum(rate(spring_ai_advisor_seconds_count{application=\"spring-ai-ragr\"}[1h])) by (spring_ai_advisor_name)",
          "legendFormat": "{{spring_ai_advisor_name}} avg",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(spring_ai_advisor_seconds_bucket{application=\"spring-ai-ragr\"}[1h])) by (le, spring_ai_advisor_name))",
          "exemplar": true,
          "legendFormat": "p95 {{spring_ai_advisor_name}}",
          "refId": "B"
        }
      ]
    },

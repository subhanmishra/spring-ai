  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Model calls — Ollama",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "LLM call rate by operation",
      "description": "gen_ai_client_operation_seconds_count — Ollama chat vs. embedding calls",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_operation_seconds_count{application=\"spring-ai-ragr\"}[5m])) by (gen_ai_operation_name, gen_ai_response_model)",
          "legendFormat": "{{gen_ai_operation_name}} ({{gen_ai_response_model}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "LLM call latency (p50/p80/p95/p99)",
      "description": "Time per call to Ollama. Chat and embedding differ by an order of magnitude, so they are kept as separate series rather than aggregated. Quantiles and averages use a 1h window: with a handful of requests an hour, a 5m window is NaN (drawn as nothing, not as zero) except in the five minutes after a request. A value here therefore describes the last hour of requests, and a line holding flat means no new ones.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(gen_ai_client_operation_seconds_bucket{application=\"spring-ai-ragr\"}[1h])) by (le, gen_ai_operation_name))",
          "exemplar": true,
          "legendFormat": "p50 {{gen_ai_operation_name}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.80, sum(rate(gen_ai_client_operation_seconds_bucket{application=\"spring-ai-ragr\"}[1h])) by (le, gen_ai_operation_name))",
          "legendFormat": "p80 {{gen_ai_operation_name}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(gen_ai_client_operation_seconds_bucket{application=\"spring-ai-ragr\"}[1h])) by (le, gen_ai_operation_name))",
          "legendFormat": "p95 {{gen_ai_operation_name}}",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(gen_ai_client_operation_seconds_bucket{application=\"spring-ai-ragr\"}[1h])) by (le, gen_ai_operation_name))",
          "legendFormat": "p99 {{gen_ai_operation_name}}",
          "refId": "D"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM error rate",
      "description": "gen_ai_client_operation_seconds_count where error != none Empty is the healthy state: the query filters `error!=\"none\"`, and Spring AI creates no series at all until a call actually fails, so there is nothing to show rather than a zero line. Any series appearing here is a real failure.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_operation_seconds_count{application=\"spring-ai-ragr\", error!=\"none\"}[5m])) by (gen_ai_operation_name, error)",
          "legendFormat": "{{gen_ai_operation_name}} [{{error}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Tokens & throughput",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false
    },
    {
      "id": 3,
      "title": "Token usage rate",
      "description": "Token usage by operation. Here \"embedding\" is each query being embedded for the similarity search - one short input per turn - not document ingestion, which is on the ragr-ingest dashboard.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_token_usage_total{application=\"spring-ai-ragr\"}[5m])) by (gen_ai_operation_name, gen_ai_token_type)",
          "legendFormat": "{{gen_ai_operation_name}} - {{gen_ai_token_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "title": "Chat generation throughput — gemma4:e2b (30m avg)",
      "description": "Output tokens per second of chat request time, averaged over 30 minutes. NOT a rate over wall-clock: gen_ai_client_token_usage_total is incremented once per request when the response completes, so rate() spreads one answer's tokens across the whole window and measures request arrival, not speed - a real 373-token answer generating at 9.36 tok/s registered as 0 on the previous 5m-rate version of this panel. Dividing by gen_ai_client_operation_seconds_sum makes it window-independent. Read it as end-to-end responsiveness, not raw decode speed: the denominator is whole-request duration, which includes prompt evaluation, and prompt eval produces no output tokens. So it approaches Ollama's reported tg when the answer is long and reads below it when the answer is short against a large RAG prompt - measured 10.34 for a 373-token answer (tg 9.36) but 5.76 for a 51-token answer (tg 9.48, with 1.9s of the 9.2s spent evaluating a 347-token prompt). For raw decode speed, read tg in Ollama's server log. This division is valid here only because chat requests are serial - do not copy it to the embedding panel, which runs concurrently. Input tokens are excluded because the RAG context makes the prompt far larger than the answer. BLANK WHILE IDLE BY DESIGN: the query ends in `> 0` and averages over 30m, so it reads empty when no answer has been generated in that window. Divides output tokens by the time Ollama spent generating them, so it is tokens per second of generation, not per second of wall clock.",
      "type": "gauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 40,
          "noValue": "idle",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "blue",
                "value": 1
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_token_usage_total{application=\"spring-ai-ragr\", gen_ai_operation_name=\"chat\", gen_ai_token_type=\"output\"}[30m])) / sum(rate(gen_ai_client_operation_seconds_sum{application=\"spring-ai-ragr\", gen_ai_operation_name=\"chat\"}[30m])) > 0",
          "instant": true,
          "range": false,
          "legendFormat": "tok/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 26,
      "title": "Chat tokens in / out (cumulative)",
      "description": "Prompt versus completion tokens for the chat model since startup. The input figure includes the retrieved RAG context that QuestionAnswerAdvisor injects, so it grows much faster than output.",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(gen_ai_client_token_usage_total{application=\"spring-ai-ragr\", gen_ai_operation_name=\"chat\", gen_ai_token_type=\"input\"})",
          "legendFormat": "input",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(gen_ai_client_token_usage_total{application=\"spring-ai-ragr\", gen_ai_operation_name=\"chat\", gen_ai_token_type=\"output\"})",
          "legendFormat": "output",
          "refId": "B"
        }
      ]
    },

{
  "uid": "spring-ai-ragr-overview",
  "title": "spring-ai-ragr overview",
  "tags": ["spring-boot", "micrometer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "jvm_memory_used_bytes{application=\"spring-ai-ragr\", area=\"heap\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "JVM GC pause time (5m rate)",
      "description": "Seconds of stop-the-world pause per second, split by cause. The legend must include {{cause}}: jvm_gc_pause_seconds carries both action and cause, and every series this app produces has action=\"end of minor GC\", so a legend of {{action}} alone rendered three different series under three identical labels. G1 Evacuation Pause is the normal young collection and should dominate. CodeCache GC Threshold is JIT code-cache pressure rather than heap pressure, and is normal during warm-up. G1 Humongous Allocation is the one worth watching: heap max is ~4 GiB so the G1 region size is 2 MiB, which makes any allocation of 1 MiB or more humongous - it skips the normal fast path and lands directly in contiguous old-gen regions. Document upload is the obvious source, since the test corpus arrives as a 13.6 MB byte[], so this series is a proxy for ingestion allocating large objects.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"spring-ai-ragr\"}[5m])",
          "legendFormat": "{{action}} · {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "HTTP request rate by status — controller endpoints",
      "description": "/ai/** (ChatController) and /api/v1/documents/** (DocumentController)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"spring-ai-ragr\", uri=~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (uri, status)",
          "exemplar": true,
          "legendFormat": "{{uri}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "HTTP request rate by status — other endpoints",
      "description": "Everything outside the application's own controllers (actuator, swagger-ui, api-docs, error, etc.)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"spring-ai-ragr\", uri!~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (uri, status)",
          "exemplar": true,
          "legendFormat": "{{uri}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP request latency (p50/p80/p95/p99) — controller endpoints",
      "description": "/ai/** (ChatController) and /api/v1/documents/** (DocumentController)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"spring-ai-ragr\", uri=~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (le, uri))",
          "exemplar": true,
          "legendFormat": "{{uri}} p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.80, sum(rate(http_server_requests_seconds_bucket{application=\"spring-ai-ragr\", uri=~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (le, uri))",
          "exemplar": true,
          "legendFormat": "{{uri}} p80",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"spring-ai-ragr\", uri=~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (le, uri))",
          "exemplar": true,
          "legendFormat": "{{uri}} p95",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"spring-ai-ragr\", uri=~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (le, uri))",
          "exemplar": true,
          "legendFormat": "{{uri}} p99",
          "refId": "D"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP request latency (p50/p80/p95/p99) — other endpoints",
      "description": "Everything outside the application's own controllers (actuator, swagger-ui, api-docs, error, etc.)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"spring-ai-ragr\", uri!~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (le, uri))",
          "exemplar": true,
          "legendFormat": "{{uri}} p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.80, sum(rate(http_server_requests_seconds_bucket{application=\"spring-ai-ragr\", uri!~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (le, uri))",
          "exemplar": true,
          "legendFormat": "{{uri}} p80",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"spring-ai-ragr\", uri!~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (le, uri))",
          "exemplar": true,
          "legendFormat": "{{uri}} p95",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"spring-ai-ragr\", uri!~\"^/(ai|api/v1/documents)(/.*)?$\"}[5m])) by (le, uri))",
          "exemplar": true,
          "legendFormat": "{{uri}} p99",
          "refId": "D"
        }
      ]
    },
    {
      "id": 7,
      "title": "HikariCP active / idle / pending connections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "hikaricp_connections_active{application=\"spring-ai-ragr\"}",
          "legendFormat": "active",
          "refId": "A"

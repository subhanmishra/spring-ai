      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Published by ragr-app after each answer, off the chat thread. Delivery is at most once: \"dropped\" counts turns the broker did not acknowledge, which evaluation will never see. The answer itself is never affected.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(rag_chat_turn_events_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Open rag.chat.turn.completed in Kafka console",
          "url": "http://localhost:8082/topics/rag.chat.turn.completed",
          "targetBlank": true
        }
      ]
    },
    {
      "id": 502,
      "title": "Evaluation consumer lag",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Records on rag.chat.turn.completed that ragr-eval has not yet read. It normally sits at 0; a rising line means evaluation is falling behind live traffic. Absent while ragr-eval is stopped - the consumer reports its own lag. A caught-up consumer draws a flat line along 0.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "softMax": 5,
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (partition) (kafka_consumer_fetch_manager_records_lag{topic=\"rag.chat.turn.completed\"})",
          "legendFormat": "partition {{partition}}",
          "refId": "A"
        }
      ],
      "links": [
        {
          "title": "Open the ragr-eval consumer group in Kafka console",
          "url": "http://localhost:8082/groups/ragr-eval",
          "targetBlank": true
        }
      ]
    },

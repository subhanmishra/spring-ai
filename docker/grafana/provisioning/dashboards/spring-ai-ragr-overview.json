            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\", uri=~\"^/(ai|api/v1)(/.*)?$\"}[1h])) by (le, application, uri))",
          "legendFormat": "{{application}} {{uri}} p99",
          "refId": "D"

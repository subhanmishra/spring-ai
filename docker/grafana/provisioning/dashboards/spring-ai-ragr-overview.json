  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "JVM runtime",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "id": 1,
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (jvm_memory_used_bytes{application=~\"$application\", area=\"heap\"})",
          "legendFormat": "{{application}} used",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (jvm_memory_max_bytes{application=~\"$application\", area=\"heap\"} > 0)",
          "legendFormat": "{{application}} max (-Xmx)",
          "refId": "B"
        }
      ],
      "description": "Heap in use per application, against its -Xmx cap. All three run capped (ragr-app 384m, ragr-ingest 512m, ragr-eval 256m) because the host has a few hundred MB to spare once both Ollama models are loaded; a used line pressing against its max line is the one to watch."
    },
    {
      "id": 2,
      "title": "JVM GC pause time (5m rate)",
      "description": "Seconds of stop-the-world pause per second, split by cause. The legend must include {{cause}}: jvm_gc_pause_seconds carries both action and cause, and every series this app produces has action=\"end of minor GC\", so a legend of {{action}} alone rendered three different series under three identical labels. G1 Evacuation Pause is the normal young collection and should dominate. CodeCache GC Threshold is JIT code-cache pressure rather than heap pressure, and is normal during warm-up. G1 Humongous Allocation is the one worth watching: heap max is ~4 GiB so the G1 region size is 2 MiB, which makes any allocation of 1 MiB or more humongous - it skips the normal fast path and lands directly in contiguous old-gen regions. Document upload is the obvious source, since the test corpus arrives as a 13.6 MB byte[], so this series is a proxy for ingestion allocating large objects.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (application) (rate(jvm_gc_pause_seconds_sum{application=~\"$application\"}[5m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "JVM live threads",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "jvm_threads_live_threads{application=~\"$application\"}",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },

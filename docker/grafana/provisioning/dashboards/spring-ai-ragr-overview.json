    {
      "id": 5,
      "title": "HTTP request latency (p50/p80/p95/p99) — API endpoints",
      "description": "/ai/** (ChatController) and /api/v1/documents/** (DocumentController) Quantiles and averages use a 1h window: with a handful of requests an hour, a 5m window is NaN (drawn as nothing, not as zero) except in the five minutes after a request. A value here therefore describes the last hour of requests, and a line holding flat means no new ones.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\", uri=~\"^/(ai|api/v1)(/.*)?$\"}[1h])) by (le, application, uri))",
          "legendFormat": "{{application}} {{uri}} p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.80, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\", uri=~\"^/(ai|api/v1)(/.*)?$\"}[1h])) by (le, application, uri))",
          "legendFormat": "{{application}} {{uri}} p80",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=~\"$application\", uri=~\"^/(ai|api/v1)(/.*)?$\"}[1h])) by (le, application, uri))",
          "legendFormat": "{{application}} {{uri}} p95",
          "refId": "C"

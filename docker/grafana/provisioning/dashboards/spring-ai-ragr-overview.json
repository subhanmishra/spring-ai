    {
      "id": 12,
      "title": "Redis keyspace hit rate",
      "description": "hits / (hits + misses), over a 5m rate window",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(redis_keyspace_hits_total{job=\"redis\"}[5m]) / clamp_min(rate(redis_keyspace_hits_total{job=\"redis\"}[5m]) + rate(redis_keyspace_misses_total{job=\"redis\"}[5m]), 1e-9)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "title": "Postgres connections by state",
      "description": "Server-side view of the same connections HikariCP reports. A growing 'idle in transaction' count means transactions are being held open — which is what ingestion does while it waits on Ollama to embed.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(pg_stat_activity_count{datname=\"ragdatabase\"}) by (state)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "title": "Postgres buffer cache hit ratio",
      "description": "blks_hit / (blks_hit + blks_read) over a 5m window. A sustained drop means the working set no longer fits in shared_buffers and vector reads are hitting disk.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * rate(pg_stat_database_blks_hit{datname=\"ragdatabase\"}[5m]) / clamp_min(rate(pg_stat_database_blks_hit{datname=\"ragdatabase\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"ragdatabase\"}[5m]), 1e-9)",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "Postgres transaction rate",
      "description": "Commits and rollbacks per second. Each ingestion batch is its own REQUIRES_NEW transaction, so the commit rate tracks batch throughput; a rollback spike means batches are failing.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pg_stat_database_xact_commit{datname=\"ragdatabase\"}[5m])",
          "legendFormat": "commits/sec",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"ragdatabase\"}[5m])",
          "legendFormat": "rollbacks/sec",
          "refId": "B"
        }
      ]
    }
  ],
  "description": "JVM runtime, Spring MVC, the application datasource and the backing services it depends on. AI and RAG panels deliberately live on the separate \"AI / RAG metrics\" dashboard, so this one answers \"is the application healthy\" without model or retrieval detail."
}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>spring-ai-ragr</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-ai-ragr</name>
    <description>Retrieval-augmented generation service and the modules it shares</description>

    <!-- ragr-citations is shared because the chat path and evaluation must read citations with the
         same code: ChatService resolves and strips them to build every answer, and the scorer counts
         them afterwards. Scores computed by a copy of the parser that had drifted would describe
         nothing. -->
    <modules>
        <module>ragr-citations</module>
        <module>ragr-app</module>
    </modules>

    <properties>
        <java.version>26</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <springdoc.version>3.1.0</springdoc.version>
        <modelmapper.version>3.2.4</modelmapper.version>
        <!-- Matches the version spring-ai-tika-document-reader already pulls in, so the explicit
             declaration in ragr-app does not introduce a second copy on the classpath. -->
        <jsoup.version>1.22.2</jsoup.version>
        <!-- Test tags excluded from the ordinary build. Cleared on the command line to run the
             evaluation suite: ./mvnw test -Dsurefire.excludedGroups= -Dtest=EvalSuiteIT -->
        <surefire.excludedGroups>eval</surefire.excludedGroups>
        <!-- So that the command above still works from the root. -Dtest is applied to every module in
             the reactor, and without this each module that has no EvalSuiteIT fails the build for
             matching nothing. The cost is that a mistyped -Dtest now runs nothing and passes. -->
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
        <!-- Only ragr-app has a main class. Skipped everywhere else so ./mvnw spring-boot:run works
             from the root; ragr-app sets it back to false. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>ragr-citations</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- EvalSuiteIT replays the curated evaluation dataset through the real chat path.
                         It needs Postgres, Redis and Ollama up with the reference manual already
                         indexed, and it takes minutes - one grounded answer on the dev host is 53-70
                         seconds - so it must not run as part of the ordinary build.

                         Run it deliberately with:

                             ./mvnw test -Dsurefire.excludedGroups= -Dtest=EvalSuiteIT

                         Note -Dgroups=eval on its own does NOT work, which is the obvious thing to
                         try: in JUnit 5 tag filtering an exclusion beats an inclusion, so the tag
                         stays excluded however it is included. The exclusion itself has to be cleared,
                         which is why it is bound to an overridable property rather than hardcoded. -->
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

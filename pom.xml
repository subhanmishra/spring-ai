<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>spring-ai-ragr</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>spring-ai-ragr</name>
    <description>Retrieval-augmented generation service and the modules it shares</description>

    <!-- Three applications and one library. ragr-shared holds what they must agree on exactly - chunk
         metadata keys, the citation code, the embedding task prefix, the Kafka events and the error
         handling - so no two copies can drift apart. -->
    <modules>
        <module>ragr-shared</module>
        <module>ragr-app</module>
        <module>ragr-ingest</module>
        <module>ragr-eval</module>
    </modules>

    <properties>
        <java.version>26</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <springdoc.version>3.1.0</springdoc.version>
        <modelmapper.version>3.2.4</modelmapper.version>
        <!-- The version spring-ai-tika-document-reader already brings, so ragr-ingest's explicit
             declaration adds no second copy. -->
        <jsoup.version>1.22.2</jsoup.version>
        <!-- Test tags excluded from the ordinary build; cleared on the command line to run the golden
             suite (see surefire below). -->
        <surefire.excludedGroups>eval</surefire.excludedGroups>
        <!-- So the command above works from the root: -Dtest applies to every module, and each one
             without EvalSuiteIT would fail for matching nothing. The cost: a mistyped -Dtest runs nothing
             and passes. -->
        <surefire.failIfNoSpecifiedTests>false</surefire.failIfNoSpecifiedTests>
        <!-- ragr-shared has no main class, so spring-boot:run is skipped by default; each application
             sets this back to false. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>ragr-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- EvalSuiteIT replays the golden dataset through the running ragr-app, with the
                         corpus stored, and takes minutes - so it is not part of the ordinary build.
                         Run it with:

                             ./mvnw test -pl ragr-eval -am -Dsurefire.excludedGroups= -Dtest=EvalSuiteIT

                         -Dgroups=eval alone does NOT work: in JUnit 5 an exclusion beats an inclusion,
                         so the exclusion itself must be cleared - hence a property, not a fixed value. -->
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

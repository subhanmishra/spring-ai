<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>ragr-service-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../ragr-service-parent/pom.xml</relativePath>
    </parent>
    <artifactId>ragr-eval</artifactId>
    <name>ragr-eval</name>
    <description>Scores answer quality: live chat turns from Kafka, and the curated golden suite</description>

    <properties>
        <!-- Measured at 265 MB in total, 63 MB of heap. The test JVM, which runs EvalSuiteIT beside
             ragr-app and both models, reached 930 MB uncapped. -->
        <ragr.heap>256m</ragr.heap>
    </properties>

    <!-- From ragr-service-parent: ragr-shared, observability, and
         - web: the actuator endpoints Prometheus scrapes, the human-review API, and the RestClient the
           golden suite drives chat with and the idle gate reads it by;
         - validation: the human-review request body;
         - Ollama: the judges only; embedding is switched off in configuration.
         Deliberately no vector store, no Redis, no document readers and no spring-boot-docker-compose:
         this application reads everything a turn needs from the event, and it must never start or stop
         the stack that ragr-app owns. -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!-- The eval schema: run and per-case results, and the golden gauges read back from them. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Reads the golden dataset. Jackson 3, the version Boot manages; see GoldenDatasetLoader. -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
    </dependencies>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>spring-ai-ragr</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>ragr-app</artifactId>
    <name>ragr-app</name>
    <description>The chat service: grounded Q&amp;A over the indexed corpus, publishing each turn to Kafka</description>
    <properties>
        <spring-boot.run.skip>false</spring-boot.run.skip>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>ragr-shared</artifactId>
        </dependency>
        <!-- Publishes each completed chat turn for evaluation to consume off the chat path. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- 1. OpenTelemetry SDK autoconfiguration (provides the base OpenTelemetry/Tracer beans) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-opentelemetry</artifactId>
        </dependency>
        <!-- 2. Micrometer Tracing Bridge for OpenTelemetry -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>

        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.loki4j</groupId>
            <artifactId>loki-logback-appender</artifactId>
            <version>2.0.3</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--		<dependency>-->
        <!--			<groupId>org.springframework.ai</groupId>-->
        <!--			<artifactId>spring-ai-starter-model-openai</artifactId>-->
        <!--		</dependency>-->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store-advisor</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-spring-boot-docker-compose</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model-chat-memory-repository-redis</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Run from the repository root, as IntelliJ does by default, so Docker Compose
                         finds the root compose.yaml. See spring.docker.compose in
                         application-dev.yaml. -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                    <!-- Measured over a grounded chat turn: heap peaked at 242 MB uncapped (with a 4 GB
                         default max, so largely uncollected garbage) and 150 MB under this cap, 471 MB
                         private against 726 MB uncapped. The host has a few hundred MB to spare once
                         both Ollama models are loaded.
                         SerialGC rather than the default G1, measured over three grounded turns: peak
                         private 448 MB under G1, 333 MB under Serial. Native memory tracking puts G1's own
                         bookkeeping at 63 MB against 0 for Serial, and Serial also keeps the committed
                         heap smaller (128 MB against 181). Four collections took 81 ms in total, so no
                         pause a chat turn could notice. The IntelliJ run configuration needs the same VM
                         options. -->
                    <jvmArguments>-Xmx384m -XX:+UseSerialGC</jvmArguments>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- docs/ holds the golden corpus, the 13.6 MB reference manual, kept here only to be
                         uploaded to ragr-ingest from disk; nothing reads it from the classpath. Packaged,
                         it was nearly all of the application layer in the Docker image, re-sent on every
                         code change. Excluded from the jar only, not from resources, so it still lands in
                         target/classes and the parent's resource filtering is left alone. -->
                    <excludes>
                        <exclude>docs/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The same cap for the test JVM, which loads the full context beside the running
                         applications. Merged with the parent's surefire configuration. -->
                    <argLine>-Xmx384m -XX:+UseSerialGC</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
